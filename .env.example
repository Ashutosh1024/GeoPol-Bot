# ==============================================================================
# GeoPol Bot - Environment Configuration Template
# Copy this file to .env and populate the required values.
# NEVER commit the actual .env file or your API keys to version control!
# ==============================================================================

# Project & Environment
PROJECT_NAME="GeoPol Bot"
PROJECT_VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=true

# API Server Configuration
BACKEND_HOST="127.0.0.1"
BACKEND_PORT=8000
API_V1_PREFIX="/api/v1"

# CORS Settings (Comma-separated origins allowed to contact FastAPI)
CORS_ORIGINS="http://localhost:8501,http://127.0.0.1:8501"

# OpenAI Configuration (BACKEND ONLY - NEVER EXPOSED TO FRONTEND)
# Required for OpenAI Responses API, Domain Gating, and Answer Generation
OPENAI_API_KEY="sk-your-openai-api-key-here"
OPENAI_MODEL="gpt-4o-mini"
OPENAI_TIMEOUT_SECONDS=30.0

# Frontend Configuration (Used by Streamlit to communicate with FastAPI backend)
BACKEND_API_URL="http://127.0.0.1:8000/api/v1"
